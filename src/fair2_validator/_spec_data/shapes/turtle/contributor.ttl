@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix schema: <https://schema.org/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix fair2s: <https://fair2.ai/shapes/> .
@prefix fair2: <https://fair2.ai/ns/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

fair2s:PersonOrOrganizationShape
    a sh:NodeShape ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:property [
        sh:path schema:name ;
        sh:minCount 1 ;
        sh:node fair2s:TextShape ;
    ] ;
    sh:property [
        sh:path schema:affiliation ;
        sh:node fair2s:OrganizationShape ;
    ] .

fair2s:OrganizationShape
    a sh:NodeShape ;
    sh:property [
        sh:path schema:name ;
        sh:minCount 1 ;
        sh:node fair2s:TextShape ;
    ] .

fair2s:ContributorRoleShape
    a sh:NodeShape ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:or (
        [ sh:property [ sh:path schema:name ; sh:minCount 1 ; sh:node fair2s:TextShape ] ]
        [ sh:property [ sh:path schema:propertyID ; sh:minCount 1 ; sh:node fair2s:TextShape ] ]
        [ sh:property [ sh:path rdfs:label ; sh:minCount 1 ; sh:node fair2s:TextShape ] ]
    ) .

fair2s:AttributionShape
    a sh:NodeShape ;
    sh:targetClass prov:Attribution ;
    sh:nodeKind sh:IRI ;
    sh:description "A dataset's relationship to one agent: who they are, what roles they held, and where they sat in the list. Every domain here checks out, unlike prov:hadRole on a Person." ;

    sh:property [
        sh:path prov:agent ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:description "The Person or Organization, by reference. Described once under schema:creator."
    ] ;
    sh:property [
        sh:path prov:hadRole ;
        sh:minCount 1 ;
        sh:node fair2s:ContributorRoleShape ;
        sh:description "One or more roles, drawn from CRediT, CRO or the FAIR2 role vocabulary."
    ] ;
    sh:property [
        sh:path fair2:position ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:description "Ordinal position in the author list. RDF loses array order, so it must be stated."
    ] .
