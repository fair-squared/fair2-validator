@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix schema: <https://schema.org/> .
@prefix cr: <http://mlcommons.org/croissant/> .
@prefix fair2: <https://fair2.ai/ns/> .
@prefix fair2s: <https://fair2.ai/shapes/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

fair2s:DatasetShape
    a sh:NodeShape ;
    sh:targetClass schema:Dataset ;
    sh:nodeKind sh:IRI ;

    sh:property [
        sh:path schema:name ;
        sh:node fair2s:TextShape ;
        sh:minCount 1 ;
        sh:message "Name must be a string or a language-tagged string."
    ] ;
    sh:property [ sh:path schema:description ; sh:minCount 1 ; sh:node fair2s:TextShape ] ;
    sh:property [ sh:path schema:identifier ; sh:minCount 1 ; sh:node fair2s:IdentifierShape ] ;
    sh:property [ sh:path schema:version ; sh:minCount 1 ; sh:node fair2s:TextShape ] ;
    sh:property [ sh:path schema:license ; sh:minCount 1 ; sh:node fair2s:IdentifierShape ] ;
    sh:property [ sh:path schema:url ; sh:minCount 1 ; sh:node fair2s:IdentifierShape ] ;
    sh:property [ sh:path schema:keywords ; sh:minCount 1 ; sh:node fair2s:TextShape ] ;

    sh:property [ sh:path dct:conformsTo ; sh:minCount 1 ; sh:node fair2s:IdentifierShape ] ;

    # The FAIR2 spec version the document was produced against. Carried as one
    # of the dct:conformsTo values, alongside the Croissant version. Until
    # v1.4.0 this lived in a non-RDF _meta block and had to be enforced outside
    # SHACL; it is an ordinary constraint now.
    sh:property [
        sh:path dct:conformsTo ;
        sh:qualifiedValueShape [ sh:pattern "^https://fair2\\.ai/spec/v[0-9]+\\.[0-9]+\\.[0-9]+$" ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "A dataset must declare the FAIR2 spec version it conforms to, as a https://fair2.ai/spec/vX.Y.Z value of dct:conformsTo."
    ] ;

    # The metadata document's own version and edit date, distinct from the
    # dataset's. Both were required fields of the _meta block before v1.4.0.
    sh:property [
        sh:path fair2:metadataVersion ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:pattern "^[0-9]+\\.[0-9]+\\.[0-9]+$" ;
        sh:message "metadataVersion must be a MAJOR.MINOR.PATCH version for the fair2.json document itself."
    ] ;
    sh:property [
        sh:path fair2:metadataModified ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:date
    ] ;
    sh:property [ sh:path cr:citeAs ; sh:node fair2s:TextShape ] ;

    sh:property [
        sh:path fair2:methodSection ;
        sh:node fair2s:MethodSectionShape
    ] ;
    sh:property [
        sh:path cr:recordSet ;
        sh:node fair2s:RecordSetShape
    ] ;

    sh:property [
        sh:path schema:creator ;
        sh:minCount 1 ;
        sh:node fair2s:PersonOrOrganizationShape
    ] ;
    # Roles are stated on the attribution, not on the person: prov:hadRole has
    # domain prov:Influence, and a role held with no stated relationship is not
    # scoped to this dataset. schema:contributor is gone - it duplicated
    # schema:creator, and schema.org's contributor means a secondary one.
    sh:property [
        sh:path prov:qualifiedAttribution ;
        sh:node fair2s:AttributionShape
    ] ;
    sh:property [
        sh:path schema:funding ;
        sh:node fair2s:GrantShape
    ] ;

    sh:property [
        sh:path schema:temporalCoverage ;
        sh:node fair2s:TextShape ;
        sh:pattern "^(\\d{4}(-\\d{2}(-\\d{2})?)?)(/(\\d{4}(-\\d{2}(-\\d{2})?)?|\\.\\.))?$" ;
        sh:message "temporalCoverage must be an ISO 8601 date or interval (e.g. '1995-01-01/2023-12-31') for Google Dataset Search compliance."
    ] ;
    sh:property [
        sh:path schema:spatialCoverage ;
        sh:node fair2s:SpatialCoverageShape
    ] ;
    sh:property [
        sh:path schema:distribution ;
        sh:minCount 1 ;
        sh:node fair2s:DistributionShape
    ] ;

    sh:property [ sh:path schema:dateCreated ; sh:datatype xsd:date ] ;
    sh:property [ sh:path schema:datePublished ; sh:datatype xsd:date ] ;
    sh:property [ sh:path schema:dateModified ; sh:datatype xsd:date ] ;
    sh:property [ sh:path fair2:changeLog ; sh:node fair2s:UpdateActionShape ] ;
    sh:property [ sh:path schema:subjectOf ; sh:node fair2s:CreativeWorkShape ] ;
    sh:property [ sh:path fair2:domain ; sh:node fair2s:DomainShape ] ;

    sh:property [ sh:path fair2s:socialMedia ; sh:node fair2s:SocialMediaShape ] ;
    sh:property [ sh:path schema:accessRights ; sh:node fair2s:AccessRightsShape ] ;

    # Peer artifacts are referenced by their own identifier, not described
    # here. Each is governed independently, so inlining a body would let a
    # change to another artifact invalidate this document and its signature.
    sh:property [
        sh:path fair2:dataArticle ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:description "The data article, by DOI or other resolvable identifier."
    ] ;
    sh:property [
        sh:path fair2:dataPortal ;
        sh:nodeKind sh:IRI ;
        sh:description "The data portal, by its own identifier."
    ] ;
    sh:property [
        sh:path fair2:dataArchive ;
        sh:nodeKind sh:IRI ;
        sh:description "The data archive, by its own identifier."
    ] .
