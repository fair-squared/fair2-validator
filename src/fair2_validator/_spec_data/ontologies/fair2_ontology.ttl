@prefix schema: <https://schema.org/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix cr: <http://mlcommons.org/croissant/> .
@prefix credit: <https://credit.niso.org/contributor-roles/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix fair2: <https://fair2.ai/ns/> .
@prefix fair2s: <https://fair2.ai/shapes/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix vs: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ddi-stats: <http://rdf-vocabulary.ddialliance.org/cv/SummaryStatisticType/2.1.2/> .
@prefix sec: <https://w3id.org/security#> .
@prefix oa: <http://www.w3.org/ns/oa#> .
@prefix dct: <http://purl.org/dc/terms/> .

# FAIR2 Ontology — 2026-03-30T12:00:00.000000Z
# Includes only terms used in published datasets.

fair2:MethodSection a rdfs:Class ;
  rdfs:label "MethodSection" ;
  rdfs:comment "Legacy alias for fair2:Section, retained so existing documents keep resolving. Declared a subclass of fair2:Section rather than of schema:HowToSection directly, so that fair2s:MethodSectionShape reaches legacy nodes too; fair2:Section supplies the schema:HowToSection parent." ;
  rdfs:subClassOf fair2:Section .

fair2:Step a rdfs:Class ;
  rdfs:label "Step" ;
  rdfs:comment "Atomic procedural instruction within a method." ;
  rdfs:subClassOf schema:HowToStep .

fair2:Substep a rdfs:Class ;
  rdfs:label "Substep" ;
  rdfs:comment "Subordinate procedural instruction nested under a Step." ;
  rdfs:subClassOf schema:HowToStep .

fair2:DescriptiveStatistics a rdfs:Class ;
  rdfs:label "DescriptiveStatistics" ;
  rdfs:comment "Deprecated. Croissant 1.1 models statistics with cr:annotation, attaching a cr:Field that carries a value rather than a source; FAIR2 documents use that from v1.5.0. This class described the wrapper the superseded fair2:statistics property pointed at, and is retained only so existing references resolve." ;
  vs:term_status "deprecated" ;
  rdfs:subClassOf schema:StructuredValue .

fair2:Submission a rdfs:Class ;
  rdfs:label "Submission" ;
  rdfs:comment "Reserved. Intended as a submission package grouping dataset, article and supporting materials for review; it has no shape or example, and whether it appears in a published fair2.json is not yet decided. Do not rely on it." ;
  rdfs:subClassOf schema:CreativeWork ;
  vs:term_status "unstable" .

fair2:DataPortal a rdfs:Class ;
  rdfs:label "DataPortal" ;
  rdfs:comment "An authored, versioned web application presenting a single FAIR² dataset - an interactive explorer or landing site, not a catalogue of many datasets and not a bare API endpoint. Hence the required author, version and keywords, and the optional changeLog." ;
  rdfs:subClassOf schema:CreativeWork .

fair2:DataArchive a rdfs:Class ;
  rdfs:label "DataArchive" ;
  rdfs:comment "An archive component that stores and preserves datasets for long-term access." ;
  rdfs:subClassOf schema:ArchiveComponent .

fair2:attachment a rdf:Property ;
  rdfs:label "attachment" ;
  rdfs:comment "Reserved. Intended to reference supplemental material in a submission package, but no domain, range, shape or example is specified yet; do not rely on it." ;
  vs:term_status "unstable" .

fair2:dataArticle a rdf:Property ;
  rdfs:label "dataArticle" ;
  rdfs:comment "Links a dataset or submission to its associated scholarly data article." ;
  schema:domainIncludes schema:Dataset ;
  schema:rangeIncludes fair2:DataArticle ;
  vs:term_status "stable" .

fair2:dataset a rdf:Property ;
  rdfs:label "dataset" ;
  rdfs:comment "References the dataset resource associated with the entity." ;
  schema:domainIncludes fair2:DataArchive, fair2:DataPortal ;
  schema:rangeIncludes schema:Dataset ;
  vs:term_status "stable" .

fair2:manuscript a rdf:Property ;
  rdfs:label "manuscript" ;
  rdfs:comment "Reserved. Intended to reference a manuscript file in a submission package, but no domain, range, shape or example is specified yet; do not rely on it." ;
  vs:term_status "unstable" .

fair2:statistics a rdf:Property ;
  rdfs:label "statistics" ;
  vs:term_status "deprecated" ;
  rdfs:comment "Deprecated. Linked a field to computed descriptive statistics; superseded from v1.5.0 by cr:annotation, which attaches each statistic as a cr:Field carrying a value. Retained only so existing references resolve." ;
  schema:domainIncludes cr:Field ;
  schema:rangeIncludes fair2:DescriptiveStatistics .

fair2:step a rdf:Property ;
  rdfs:label "step" ;
  rdfs:comment "Connects a MethodSection with its constituent Step items." ;
  schema:domainIncludes fair2:Section ;
  schema:rangeIncludes fair2:Step, fair2:StepCase ;
  vs:term_status "stable" .

fair2:store a rdf:Property ;
  rdfs:label "store" ;
  rdfs:comment "Reserved. Intended for the storage location or repository endpoint of an asset, but no domain, range, shape or example is specified yet; do not rely on it." ;
  vs:term_status "unstable" .

fair2:dataPortal a rdf:Property ;
  rdfs:label "dataPortal" ;
  rdfs:comment "Links a dataset to an associated data portal." ;
  schema:domainIncludes schema:Dataset ;
  schema:rangeIncludes fair2:DataPortal ;
  vs:term_status "stable" .

fair2:dataArchive a rdf:Property ;
  rdfs:label "dataArchive" ;
  rdfs:comment "Links a dataset to an associated data archive." ;
  schema:domainIncludes schema:Dataset ;
  schema:rangeIncludes fair2:DataArchive ;
  vs:term_status "stable" .

fair2:generated a rdf:Property ;
  rdfs:label "generated" ;
  rdfs:comment "Links a method step to the RecordSet fields or artifacts it produced (lineage)." ;
  schema:domainIncludes fair2:Step ;
  schema:rangeIncludes cr:Field ;
  vs:term_status "stable" .

# ---------------------------------------------------------------------------
# Terms used by the SHACL shapes and the JSON-LD context that were previously
# undeclared here. Domain/range use schema:domainIncludes and
# schema:rangeIncludes (union semantics) rather than rdfs:domain/rdfs:range,
# whose multiple values are read as an intersection — wrong for properties
# such as fair2:next and fair2:changeLog, which apply to several classes.
# ---------------------------------------------------------------------------

## Classes

fair2:Section a rdfs:Class ;
  rdfs:label "Section" ;
  rdfs:comment "Structured methodology section grouping procedural steps. Target of fair2s:MethodSectionShape; fair2:MethodSection is a legacy alias." ;
  rdfs:subClassOf schema:HowToSection .

fair2:StepCase a rdfs:Class ;
  rdfs:label "StepCase" ;
  rdfs:comment "Conditional branch within a method, carrying the condition and the path taken when it holds. Sits in the same fair2:step list as a Step." ;
  rdfs:subClassOf schema:HowToStep .

fair2:Certification a rdfs:Class ;
  rdfs:label "Certification" ;
  rdfs:comment "Pointer node asserting the FAIR² certification or validation status of a package, and referencing the external credential." ;
  rdfs:subClassOf schema:CreativeWork .

fair2:DataArticle a rdfs:Class ;
  rdfs:label "DataArticle" ;
  rdfs:comment "Scholarly article describing a dataset, its methods and its reuse." ;
  rdfs:subClassOf schema:ScholarlyArticle .

fair2:AuthorRole a rdfs:Class ;
  rdfs:label "AuthorRole" ;
  rdfs:comment "Role played by an author in producing the dataset (e.g. Corresponding Author)." ;
  rdfs:subClassOf schema:Role .

fair2:ContributorRole a rdfs:Class ;
  rdfs:label "ContributorRole" ;
  rdfs:comment "Contributor role drawn from the CRediT or CRO vocabularies." ;
  rdfs:subClassOf schema:Role .

## Method properties

fair2:methodSection a rdf:Property ;
  rdfs:label "methodSection" ;
  rdfs:comment "Links a dataset to a methodology section." ;
  schema:domainIncludes schema:Dataset ;
  schema:rangeIncludes fair2:Section .

fair2:substep a rdf:Property ;
  rdfs:label "substep" ;
  rdfs:comment "Nests a subordinate procedural instruction under a Step." ;
  schema:domainIncludes fair2:Step ;
  schema:rangeIncludes fair2:Substep .

fair2:next a rdf:Property ;
  rdfs:label "next" ;
  rdfs:comment "References the following element in a method sequence, so order does not depend on array position." ;
  schema:domainIncludes fair2:Section, fair2:Step, fair2:Substep, fair2:StepCase ;
  schema:rangeIncludes fair2:Section, fair2:Step, fair2:Substep, fair2:StepCase .

fair2:nextTrue a rdf:Property ;
  rdfs:label "nextTrue" ;
  rdfs:comment "The path taken when a StepCase condition holds." ;
  schema:domainIncludes fair2:StepCase ;
  schema:rangeIncludes fair2:Step .

fair2:qualifiedUsage a rdf:Property ;
  rdfs:label "qualifiedUsage" ;
  rdfs:comment "The condition governing a StepCase, as a string expression." ;
  schema:domainIncludes fair2:StepCase ;
  schema:rangeIncludes schema:Text .

## Certification properties

fair2:certifiedBy a rdf:Property ;
  rdfs:label "certifiedBy" ;
  rdfs:comment "The organisation issuing the certification." ;
  schema:domainIncludes fair2:Certification ;
  schema:rangeIncludes schema:Organization .

fair2:dateIssued a rdf:Property ;
  rdfs:label "dateIssued" ;
  rdfs:comment "Date the certification was issued." ;
  schema:domainIncludes fair2:Certification ;
  schema:rangeIncludes schema:Date .

fair2:fair2ComplianceLevel a rdf:Property ;
  rdfs:label "fair2ComplianceLevel" ;
  rdfs:comment "The FAIR² compliance level asserted for the package." ;
  schema:domainIncludes fair2:Certification ;
  schema:rangeIncludes schema:URL .

fair2:certificationDocument a rdf:Property ;
  rdfs:label "certificationDocument" ;
  rdfs:comment "Reference to the external credential document backing the certification." ;
  schema:domainIncludes fair2:Certification ;
  schema:rangeIncludes schema:URL .

fair2:certificationScope a rdf:Property ;
  rdfs:label "certificationScope" ;
  rdfs:comment "What the certification covers (e.g. metadataConformance, dataIntegrity)." ;
  schema:domainIncludes fair2:Certification ;
  schema:rangeIncludes schema:Text .

fair2:verificationEndpoint a rdf:Property ;
  rdfs:label "verificationEndpoint" ;
  rdfs:comment "Endpoint at which the certification can be verified." ;
  schema:domainIncludes fair2:Certification ;
  schema:rangeIncludes schema:URL .

## Change-log properties

fair2:changeLog a rdf:Property ;
  rdfs:label "changeLog" ;
  rdfs:comment "Record of updates made to a dataset, article, archive or portal." ;
  schema:domainIncludes schema:Dataset, schema:ScholarlyArticle, fair2:DataArchive, fair2:DataPortal ;
  schema:rangeIncludes schema:UpdateAction .

fair2:newFeatures a rdf:Property ;
  rdfs:label "newFeatures" ;
  rdfs:comment "Additions introduced by a change-log entry. A sibling property of schema:description on a schema:UpdateAction, not nested inside it." ;
  schema:domainIncludes schema:UpdateAction ;
  schema:rangeIncludes schema:Text .

fair2:improvements a rdf:Property ;
  rdfs:label "improvements" ;
  rdfs:comment "Refinements introduced by a change-log entry. A sibling property of schema:description on a schema:UpdateAction, not nested inside it." ;
  schema:domainIncludes schema:UpdateAction ;
  schema:rangeIncludes schema:Text .

fair2:bugFixes a rdf:Property ;
  rdfs:label "bugFixes" ;
  rdfs:comment "Corrections introduced by a change-log entry. A sibling property of schema:description on a schema:UpdateAction, not nested inside it." ;
  schema:domainIncludes schema:UpdateAction ;
  schema:rangeIncludes schema:Text .

fair2:otherInformation a rdf:Property ;
  rdfs:label "otherInformation" ;
  rdfs:comment "Remaining notes for a change-log entry. A sibling property of schema:description on a schema:UpdateAction, not nested inside it." ;
  schema:domainIncludes schema:UpdateAction ;
  schema:rangeIncludes schema:Text .

## Dataset and field properties

fair2:domain a rdf:Property ;
  rdfs:label "domain" ;
  rdfs:comment "Subject domain classifying the dataset." ;
  schema:domainIncludes schema:Dataset ;
  schema:rangeIncludes schema:Thing .

fair2:citationKey a rdf:Property ;
  rdfs:label "citationKey" ;
  rdfs:comment "Short citation key for the dataset (e.g. a BibTeX key)." ;
  schema:domainIncludes schema:Dataset ;
  schema:rangeIncludes schema:Text .

fair2:isExperimentRelated a rdf:Property ;
  rdfs:label "isExperimentRelated" ;
  rdfs:comment "Whether a field records an experimental observation rather than descriptive metadata." ;
  schema:domainIncludes cr:Field ;
  schema:rangeIncludes schema:Boolean .

fair2:unit a rdf:Property ;
  rdfs:label "unit" ;
  rdfs:comment "Unit of measurement for a field, referenced by its QUDT IRI." ;
  schema:domainIncludes cr:Field ;
  schema:rangeIncludes qudt:Unit .

fair2:validationReport a rdf:Property ;
  rdfs:label "validationReport" ;
  rdfs:comment "The validation report backing a certification or validation claim." ;
  schema:domainIncludes fair2:Certification ;
  schema:rangeIncludes schema:URL ;
  vs:term_status "stable" .

fair2:fundingScheme a rdf:Property ;
  rdfs:label "fundingScheme" ;
  rdfs:comment "The funding programme a grant was awarded under. schema.org defines FundingScheme as a class but has no property of that name." ;
  schema:domainIncludes schema:Grant ;
  schema:rangeIncludes schema:FundingScheme ;
  vs:term_status "stable" .

# ---------------------------------------------------------------------------
# Certification vocabulary. One compliance level says who vouches; the scope
# says what was checked (Decision A).
# ---------------------------------------------------------------------------

fair2:ComplianceLevel a rdfs:Class ;
  rdfs:label "ComplianceLevel" ;
  rdfs:comment "A FAIR² compliance status asserted for a package." ;
  rdfs:subClassOf skos:Concept ;
  vs:term_status "stable" .

fair2:Certified a fair2:ComplianceLevel ;
  rdfs:label "FAIR²-Certified" ;
  rdfs:comment "An authority assertion, backed by a credential signed by an authorised certifier. There is no metadata-only variant: fair2:certificationScope records what was checked." ;
  vs:term_status "stable" .

fair2:Validated a fair2:ComplianceLevel ;
  rdfs:label "FAIR²-Validated" ;
  rdfs:comment "A quality status asserting that the automated conformance checks pass. Self-assertable, provided the claim carries its evidence: the profile validated against, the validation run and its software agent, and the report." ;
  vs:term_status "stable" .

fair2:CertificationScope a rdfs:Class ;
  rdfs:label "CertificationScope" ;
  rdfs:comment "A facet of a package that a certification covers." ;
  rdfs:subClassOf skos:Concept ;
  vs:term_status "stable" .

fair2:MetadataConformance a fair2:CertificationScope ;
  rdfs:label "metadataConformance" ;
  rdfs:comment "The metadata conforms to the declared FAIR² profile." .

fair2:DataIntegrity a fair2:CertificationScope ;
  rdfs:label "dataIntegrity" ;
  rdfs:comment "The data files were retrieved and checked against their recorded digests. A certification whose scope omits this token must be rendered as \"FAIR²-Certified (metadata only)\"." .

fair2:LicenseVerification a fair2:CertificationScope ;
  rdfs:label "licenseVerification" ;
  rdfs:comment "The declared licence was checked for presence and internal consistency." .

fair2:ProcessAttestation a fair2:CertificationScope ;
  rdfs:label "processAttestation" ;
  rdfs:comment "The production process was attested by the certifier." .

fair2:TemporalProof a fair2:CertificationScope ;
  rdfs:label "temporalProof" ;
  rdfs:comment "An RFC 3161 timestamp or blockchain anchor is attached to the certification." .

fair2:metadataVersion a rdf:Property ;
  rdfs:label "metadataVersion" ;
  rdfs:comment "Version of the fair2.json document itself, as MAJOR.MINOR.PATCH. Independent of schema:version, which is the dataset's own release: a dataset at 1.2 may have a metadata document at 1.3.2 after several corrections. Patch for a metadata-only correction, minor for an additive change, major for a structural one." ;
  schema:domainIncludes schema:Dataset ;
  schema:rangeIncludes schema:Text ;
  vs:term_status "stable" .

fair2:metadataModified a rdf:Property ;
  rdfs:label "metadataModified" ;
  rdfs:comment "Date the fair2.json document was last edited. Distinct from schema:dateModified, which is when the dataset itself last changed; a metadata correction moves this and not that." ;
  schema:domainIncludes schema:Dataset ;
  schema:rangeIncludes schema:Date ;
  vs:term_status "stable" .

fair2:position a rdf:Property ;
  rdfs:label "position" ;
  rdfs:comment "Ordinal position of an agent in the author or contributor list, counting from 1. JSON-LD arrays are unordered sets in RDF, so author order does not survive conversion; the qualified attribution is the only place it can be stated." ;
  schema:domainIncludes prov:Attribution ;
  schema:rangeIncludes schema:Integer ;
  vs:term_status "stable" .

fair2:graphDigestMultibase a rdf:Property ;
  rdfs:label "graphDigestMultibase" ;
  rdfs:comment "Multibase-encoded multihash of the RDFC-1.0 canonical form of a fair2.json, as sha2-256 over the canonical n-quads. Companion to sec:digestMultibase, which covers the published bytes: the byte digest proves the file is unchanged, this one proves the graph is, so a document that was reserialised can be recognised as equivalent rather than reported as altered." ;
  schema:domainIncludes fair2:Certification ;
  schema:rangeIncludes schema:Text ;
  vs:term_status "stable" .

fair2:FAIR2CertificationCredential a rdfs:Class ;
  rdfs:label "FAIR2CertificationCredential" ;
  rdfs:comment "A W3C Verifiable Credential asserting the FAIR² certification status of one exact package version. Published as fair2-cert.json and referenced by fair2:certificationDocument." ;
  rdfs:subClassOf schema:CreativeWork ;
  vs:term_status "stable" .

fair2:FAIR2CertifierRegistry a rdfs:Class ;
  rdfs:label "FAIR2CertifierRegistry" ;
  rdfs:comment "The signed list of entities authorised to issue FAIR² certifications, published by the governance body." ;
  rdfs:subClassOf schema:CreativeWork ;
  vs:term_status "stable" .

fair2:licenceTier a rdf:Property ;
  rdfs:label "licenceTier" ;
  rdfs:comment "The trademark licence under which a certifier operates: non-commercial or commercial." ;
  schema:domainIncludes fair2:FAIR2CertifierRegistry ;
  schema:rangeIncludes schema:Text ;
  vs:term_status "stable" .

fair2:allowedScopes a rdf:Property ;
  rdfs:label "allowedScopes" ;
  rdfs:comment "The certification scopes a certifier is authorised to assert. A credential declaring a scope outside this set does not verify." ;
  schema:domainIncludes fair2:FAIR2CertifierRegistry ;
  schema:rangeIncludes fair2:CertificationScope ;
  vs:term_status "stable" .

fair2:certifiedDocument a rdf:Property ;
  rdfs:label "certifiedDocument" ;
  rdfs:comment "The exact fair2.json a certification's digests were taken over. Stated by URL because the filename alone is ambiguous: a FAIR² governance document shares it." ;
  schema:domainIncludes fair2:FAIR2CertificationCredential ;
  schema:rangeIncludes schema:URL ;
  vs:term_status "stable" .

fair2:SummaryStatistic a rdfs:Class ;
  rdfs:label "SummaryStatistic" ;
  rdfs:comment "A kind of descriptive statistic, named in cr:dataType on a cr:annotation. FAIR2 uses DDI-CDI SummaryStatisticType where it has a term; these three cover statistics it does not." ;
  rdfs:subClassOf skos:Concept ;
  vs:term_status "stable" .

fair2:DistinctValueCount a fair2:SummaryStatistic ;
  rdfs:label "unique" ;
  rdfs:comment "Number of distinct values in the field. DDI-CDI SummaryStatisticType has no equivalent; its c646dd8 is Valid cases, the count of non-missing values." .

fair2:ModalFrequency a fair2:SummaryStatistic ;
  rdfs:label "freq" ;
  rdfs:comment "How often the modal value occurs. Pairs with the mode itself, which is ddi-stats:650be61; DDI names the mode but not its frequency." ;
  skos:related ddi-stats:650be61 .

fair2:ExpectedValueCount a fair2:SummaryStatistic ;
  rdfs:label "expected_number_of_values" ;
  rdfs:comment "How many values the extraction expected to find, against which count and missing_values are read. Describes completeness of the extraction rather than a distribution, so it is deliberately FAIR2-local." .

fair2:FrequencyDistribution a fair2:SummaryStatistic ;
  rdfs:label "top_10_freq" ;
  rdfs:comment "Frequency of the most common values, as a JSON object mapping label to count. Carried as an rdf:JSON literal, the same mechanism Croissant uses for cr:data and cr:examples." .

# ---------------------------------------------------------------------------
# Added in v1.6.0, status "testing": terms first needed by a producer's
# output (the data wrangler), defined where no existing term in the
# vocabularies fair2.json uses says the same thing. Terms describing the
# data come first; terms recording how it was processed follow.
# ---------------------------------------------------------------------------


fair2:role a rdf:Property ;
  rdfs:label "role" ;
  rdfs:comment "The role a field plays in its record set: identifier, dimension, measure, count, category, datetime, geo or filemeta. identifier corresponds to cr:key on the record set; dimension, measure and the attribute-like roles to the RDF Data Cube component properties qb:DimensionProperty, qb:MeasureProperty and qb:AttributeProperty." ;
  schema:domainIncludes cr:Field ;
  schema:rangeIncludes xsd:string ;
  vs:term_status "testing" .

fair2:roleSource a rdf:Property ;
  rdfs:label "roleSource" ;
  rdfs:comment "Whether a field's role was asserted by a curator or computed from the data: asserted or computed." ;
  schema:domainIncludes cr:Field, schema:PropertyValue ;
  schema:rangeIncludes xsd:string ;
  vs:term_status "testing" .

fair2:valueConstraints a rdf:Property ;
  rdfs:label "valueConstraints" ;
  rdfs:comment "The values a field may take or the range it must fall in, in words. Distinct from fair2:constraints, a dataset's use constraints." ;
  schema:domainIncludes cr:Field ;
  schema:rangeIncludes xsd:string ;
  vs:term_status "testing" .

fair2:unitSingular a rdf:Property ;
  rdfs:label "unitSingular" ;
  rdfs:comment "What one record of the record set is, in the singular (e.g. cell, patient)." ;
  schema:domainIncludes cr:RecordSet ;
  schema:rangeIncludes xsd:string ;
  vs:term_status "testing" .

fair2:unitPlural a rdf:Property ;
  rdfs:label "unitPlural" ;
  rdfs:comment "The plural of fair2:unitSingular (e.g. cells, patients)." ;
  schema:domainIncludes cr:RecordSet ;
  schema:rangeIncludes xsd:string ;
  vs:term_status "testing" .

fair2:unitLabelSource a rdf:Property ;
  rdfs:label "unitLabelSource" ;
  rdfs:comment "Where the record-unit labels came from: a curated catalog or the producing agent." ;
  schema:domainIncludes cr:RecordSet ;
  schema:rangeIncludes xsd:string ;
  vs:term_status "testing" .

fair2:primaryMeasure a rdf:Property ;
  rdfs:label "primaryMeasure" ;
  rdfs:comment "The field an overview of the record set should lead with." ;
  schema:domainIncludes cr:RecordSet ;
  schema:rangeIncludes cr:Field ;
  vs:term_status "testing" .

fair2:encrypted a rdf:Property ;
  rdfs:label "encrypted" ;
  rdfs:comment "Whether the file's content is encrypted, so that it cannot be read without a key." ;
  schema:domainIncludes cr:FileObject, cr:FileSet ;
  schema:rangeIncludes xsd:boolean ;
  vs:term_status "testing" .

fair2:rowCount a rdf:Property ;
  rdfs:label "rowCount" ;
  rdfs:comment "The number of rows in a table." ;
  schema:domainIncludes cr:RecordSet, cr:FileObject, prov:Derivation ;
  schema:rangeIncludes xsd:nonNegativeInteger ;
  vs:term_status "testing" .

fair2:contextLoad a rdf:Property ;
  rdfs:label "contextLoad" ;
  rdfs:comment "Whether a documentation file was preserved in the package, and how." ;
  schema:domainIncludes cr:FileObject ;
  schema:rangeIncludes xsd:string ;
  vs:term_status "testing" .

fair2:renameRule a rdf:Property ;
  rdfs:label "renameRule" ;
  rdfs:comment "The rule by which a set of files was renamed when packaged, as a JSON object." ;
  schema:domainIncludes prov:Entity, cr:FileSet ;
  schema:rangeIncludes rdf:JSON ;
  vs:term_status "testing" .

fair2:retrievedOn a rdf:Property ;
  rdfs:label "retrievedOn" ;
  rdfs:comment "When a source was retrieved." ;
  schema:domainIncludes prov:Entity ;
  schema:rangeIncludes xsd:dateTime ;
  vs:term_status "testing" .

fair2:retrievalMethod a rdf:Property ;
  rdfs:label "retrievalMethod" ;
  rdfs:comment "How a source was obtained (e.g. provided locally, from a cache, fetched, from Crossref)." ;
  schema:domainIncludes prov:Entity ;
  schema:rangeIncludes xsd:string ;
  vs:term_status "testing" .

fair2:declaredLicenses a rdf:Property ;
  rdfs:label "declaredLicenses" ;
  rdfs:comment "Every licence a source declared, when it declared more than one; schema:license carries the one applied." ;
  schema:domainIncludes schema:Dataset, prov:Entity ;
  schema:rangeIncludes schema:CreativeWork, schema:URL ;
  vs:term_status "testing" .

fair2:resolvedBy a rdf:Property ;
  rdfs:label "resolvedBy" ;
  rdfs:comment "How a dataset's main entity was resolved." ;
  schema:domainIncludes cr:RecordSet ;
  schema:rangeIncludes xsd:string ;
  vs:term_status "testing" .

fair2:easting a rdf:Property ;
  rdfs:label "easting" ;
  rdfs:comment "A projected easting coordinate, in the units of the coordinate reference system. Named by a field's cr:equivalentProperty, as schema:longitude is for geographic coordinates." ;
  vs:term_status "testing" .

fair2:northing a rdf:Property ;
  rdfs:label "northing" ;
  rdfs:comment "A projected northing coordinate, in the units of the coordinate reference system. Named by a field's cr:equivalentProperty, as schema:latitude is for geographic coordinates." ;
  vs:term_status "testing" .

fair2:InferredJoin a rdfs:Class ;
  rdfs:label "InferredJoin" ;
  rdfs:comment "A join between record sets found by inference and not verified. Unlike cr:references, which declares a verified foreign key, it records the evidence and how far it holds. One or more fields on each side." ;
  rdfs:subClassOf prov:Entity ;
  vs:term_status "testing" .

fair2:CompositeKey a rdfs:Class ;
  rdfs:label "CompositeKey" ;
  rdfs:comment "A verified foreign key over several fields, for when Croissant cannot state it. Croissant writes one as a cr:references on each source field into the target record set's cr:key; a record set has one key, so when the target's key is another set of fields the composite is stated with this instead. Its tuple is unique on the target, and the source's tuples fall inside it." ;
  vs:term_status "testing" .

fair2:fromField a rdf:Property ;
  rdfs:label "fromField" ;
  rdfs:comment "The field or fields an inferred join or composite key starts from." ;
  schema:domainIncludes fair2:InferredJoin, fair2:CompositeKey ;
  schema:rangeIncludes cr:Field ;
  vs:term_status "testing" .

fair2:toField a rdf:Property ;
  rdfs:label "toField" ;
  rdfs:comment "The field or fields an inferred join or composite key ends at." ;
  schema:domainIncludes fair2:InferredJoin, fair2:CompositeKey ;
  schema:rangeIncludes cr:Field ;
  vs:term_status "testing" .

fair2:cardinality a rdf:Property ;
  rdfs:label "cardinality" ;
  rdfs:comment "The cardinality of an inferred join: one-to-one, one-to-many, many-to-one or many-to-many." ;
  schema:domainIncludes fair2:InferredJoin ;
  schema:rangeIncludes xsd:string ;
  vs:term_status "testing" .

fair2:confidence a rdf:Property ;
  rdfs:label "confidence" ;
  rdfs:comment "How confident the inference is: high, medium or low." ;
  schema:domainIncludes fair2:InferredJoin ;
  schema:rangeIncludes xsd:string ;
  vs:term_status "testing" .

fair2:matchedCount a rdf:Property ;
  rdfs:label "matchedCount" ;
  rdfs:comment "How many distinct values, or value tuples, of the starting side are found on the other side." ;
  schema:domainIncludes fair2:InferredJoin, fair2:CompositeKey ;
  schema:rangeIncludes xsd:nonNegativeInteger ;
  vs:term_status "testing" .

fair2:sourceDistinct a rdf:Property ;
  rdfs:label "sourceDistinct" ;
  rdfs:comment "Distinct values, or value tuples, on the side an inferred join starts from." ;
  schema:domainIncludes fair2:InferredJoin, fair2:CompositeKey ;
  schema:rangeIncludes xsd:nonNegativeInteger ;
  vs:term_status "testing" .

fair2:targetDistinct a rdf:Property ;
  rdfs:label "targetDistinct" ;
  rdfs:comment "Distinct values, or value tuples, on the side an inferred join ends at." ;
  schema:domainIncludes fair2:InferredJoin, fair2:CompositeKey ;
  schema:rangeIncludes xsd:nonNegativeInteger ;
  vs:term_status "testing" .

fair2:matchRate a rdf:Property ;
  rdfs:label "matchRate" ;
  rdfs:comment "The share of the starting side's distinct values found on the other side, from 0 to 1." ;
  schema:domainIncludes fair2:InferredJoin, fair2:CompositeKey ;
  schema:rangeIncludes xsd:decimal ;
  vs:term_status "testing" .

fair2:uniqueness a rdf:Property ;
  rdfs:label "uniqueness" ;
  rdfs:comment "How unique the joined key is on the side it ends at, from 0 to 1." ;
  schema:domainIncludes fair2:InferredJoin ;
  schema:rangeIncludes xsd:decimal ;
  vs:term_status "testing" .

fair2:PrivacyScreening a rdfs:Class ;
  rdfs:label "PrivacyScreening" ;
  rdfs:comment "An assessment of whether, and how, a dataset can be published without disclosing personal information." ;
  rdfs:subClassOf prov:Activity ;
  vs:term_status "testing" .

fair2:subjectType a rdf:Property ;
  rdfs:label "subjectType" ;
  rdfs:comment "Who or what the data is about, as assessed by a privacy screening (e.g. human participants)." ;
  schema:domainIncludes fair2:PrivacyScreening ;
  schema:rangeIncludes xsd:string ;
  vs:term_status "testing" .

fair2:decision a rdf:Property ;
  rdfs:label "decision" ;
  rdfs:comment "The outcome of a privacy screening." ;
  schema:domainIncludes fair2:PrivacyScreening ;
  schema:rangeIncludes xsd:string ;
  vs:term_status "testing" .

fair2:action a rdf:Property ;
  rdfs:label "action" ;
  rdfs:comment "The change a privacy screening requires of a field (e.g. drop, generalise, hash), on the oa:Annotation, motivated by oa:editing, that targets it." ;
  schema:domainIncludes oa:Annotation ;
  schema:rangeIncludes xsd:string ;
  vs:term_status "testing" .

fair2:userOverride a rdf:Property ;
  rdfs:label "userOverride" ;
  rdfs:comment "Whether the person running the screening overrode its decision." ;
  schema:domainIncludes fair2:PrivacyScreening ;
  schema:rangeIncludes xsd:boolean ;
  vs:term_status "testing" .

fair2:narrativeWithheld a rdf:Property ;
  rdfs:label "narrativeWithheld" ;
  rdfs:comment "Whether narrative detail of the screening was withheld from the public record." ;
  schema:domainIncludes fair2:PrivacyScreening ;
  schema:rangeIncludes xsd:boolean ;
  vs:term_status "testing" .

fair2:IntegrityAssessment a rdfs:Class ;
  rdfs:label "IntegrityAssessment" ;
  rdfs:comment "An assessment of a dataset's internal consistency and completeness. The issues it finds are oa:Annotations motivated by oa:assessing." ;
  rdfs:subClassOf prov:Activity ;
  vs:term_status "testing" .

fair2:overallScore a rdf:Property ;
  rdfs:label "overallScore" ;
  rdfs:comment "A single score summarising an integrity assessment." ;
  schema:domainIncludes fair2:IntegrityAssessment ;
  schema:rangeIncludes xsd:decimal ;
  vs:term_status "testing" .

fair2:checks a rdf:Property ;
  rdfs:label "checks" ;
  rdfs:comment "The individual checks of an integrity assessment and their results, as a JSON object." ;
  schema:domainIncludes fair2:IntegrityAssessment ;
  schema:rangeIncludes rdf:JSON ;
  vs:term_status "testing" .

fair2:severity a rdf:Property ;
  rdfs:label "severity" ;
  rdfs:comment "How severe an issue is, on the oa:Annotation that records it." ;
  schema:domainIncludes oa:Annotation ;
  schema:rangeIncludes xsd:string ;
  vs:term_status "testing" .

fair2:complianceStatus a rdf:Property ;
  rdfs:label "complianceStatus" ;
  rdfs:comment "How far a standard applied to the dataset was complied with." ;
  schema:domainIncludes prov:Activity ;
  schema:rangeIncludes xsd:string ;
  vs:term_status "testing" .

fair2:matchSource a rdf:Property ;
  rdfs:label "matchSource" ;
  rdfs:comment "Where a match to an ontology concept came from." ;
  schema:rangeIncludes xsd:string ;
  vs:term_status "testing" .

# ── Governance (v1.7.0) ─────────────────────────────────────────────────
# Each block is a JSON value (rdf:JSON): its contents are defined by
# schemas/fair2-governance.schema.json, not by vocabulary terms. See
# docs/specification/governance.md.

fair2:access a rdf:Property ;
  rdfs:label "access" ;
  rdfs:comment "The dataset's access tier and the conditions on access (the +G, +S, +C, +P, +J and +Q modifiers), as a JSON object. When absent, or without a tier, the dataset is L0 (open)." ;
  schema:domainIncludes schema:Dataset ;
  schema:rangeIncludes rdf:JSON ;
  vs:term_status "testing" .

fair2:constraints a rdf:Property ;
  rdfs:label "constraints" ;
  rdfs:comment "Use constraints on the dataset - AI training, export, commercial use and combination with other datasets - as a JSON object." ;
  schema:domainIncludes schema:Dataset ;
  schema:rangeIncludes rdf:JSON ;
  vs:term_status "testing" .

fair2:embargo a rdf:Property ;
  rdfs:label "embargo" ;
  rdfs:comment "A date before which governed (L1 and above) data is not released, and who is exempt, as a JSON object." ;
  schema:domainIncludes schema:Dataset ;
  schema:rangeIncludes rdf:JSON ;
  vs:term_status "testing" .

fair2:variableGovernance a rdf:Property ;
  rdfs:label "variableGovernance" ;
  rdfs:comment "Access tiers and rules for individual columns, files, asset classes and record partitions, as a JSON object." ;
  schema:domainIncludes schema:Dataset ;
  schema:rangeIncludes rdf:JSON ;
  vs:term_status "testing" .

fair2:temporalGovernance a rdf:Property ;
  rdfs:label "temporalGovernance" ;
  rdfs:comment "Phases in which the access tier or environment changes over time, as a JSON object." ;
  schema:domainIncludes schema:Dataset ;
  schema:rangeIncludes rdf:JSON ;
  vs:term_status "testing" .

fair2:agentGovernance a rdf:Property ;
  rdfs:label "agentGovernance" ;
  rdfs:comment "Whether and how AI agents acting for a person may use the dataset, as a JSON object." ;
  schema:domainIncludes schema:Dataset ;
  schema:rangeIncludes rdf:JSON ;
  vs:term_status "testing" .

fair2:consentGovernance a rdf:Property ;
  rdfs:label "consentGovernance" ;
  rdfs:comment "How participants' consent withdrawals affect access, as a JSON object." ;
  schema:domainIncludes schema:Dataset ;
  schema:rangeIncludes rdf:JSON ;
  vs:term_status "testing" .

fair2:indigenousGovernance a rdf:Property ;
  rdfs:label "indigenousGovernance" ;
  rdfs:comment "The Indigenous data governance framework, governance bodies and cultural protocols that apply, as a JSON object." ;
  schema:domainIncludes schema:Dataset ;
  schema:rangeIncludes rdf:JSON ;
  vs:term_status "testing" .

fair2:distributionGovernance a rdf:Property ;
  rdfs:label "distributionGovernance" ;
  rdfs:comment "How decryption keys reach named recipients when data is shipped outside a broker network, as a JSON object." ;
  schema:domainIncludes schema:Dataset ;
  schema:rangeIncludes rdf:JSON ;
  vs:term_status "testing" .

fair2:encryption a rdf:Property ;
  rdfs:label "encryption" ;
  rdfs:comment "How the dataset's governed data is encrypted and where keys are released, as a JSON object written by a governance service." ;
  schema:domainIncludes schema:Dataset ;
  schema:rangeIncludes rdf:JSON ;
  vs:term_status "testing" .

fair2:AccessTier a rdfs:Class ;
  rdfs:label "AccessTier" ;
  rdfs:comment "An access tier of the FAIR² governance model: L0 (open), L1 (registered) or L2 (credentialed). Named by accessRights; fair2:access states it as a JSON field." ;
  rdfs:subClassOf skos:Concept ;
  vs:term_status "testing" .

fair2:L0 a fair2:AccessTier ;
  rdfs:label "L0 — Open" ;
  rdfs:comment "No authentication. Data is distributed unencrypted; the governance terms state licence and use conditions but do not gate access." ;
  vs:term_status "testing" .

fair2:L1 a fair2:AccessTier ;
  rdfs:label "L1 — Registered" ;
  rdfs:comment "An authenticated identity and acceptance of the terms." ;
  vs:term_status "testing" .

fair2:L2 a fair2:AccessTier ;
  rdfs:label "L2 — Credentialed" ;
  rdfs:comment "The dataset's credential requirements - by default a signed data use agreement." ;
  vs:term_status "testing" .

# Agreement Levels 0-6 (deprecated in v1.7.0). Both spellings were in use:
# AgreementLevel<n> in the level pages, AgreementLevels<n> in the reference
# example and the documents built from it. dct:isReplacedBy names the
# tier; the other blocks a level implied are in governance.md.

fair2:AgreementLevel0 a skos:Concept ;
  rdfs:label "Agreement Level 0 — Embargoed" ;
  rdfs:comment "Deprecated in v1.7.0. Agreement Levels had no machine-readable form beyond a label, and governance services do not read them; state the access tier and governance blocks instead (docs/specification/governance.md). Retained only so existing references resolve." ;
  dct:isReplacedBy fair2:L1 ;
  vs:term_status "deprecated" .

